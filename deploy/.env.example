# 이 파일을 deploy/.env 로 복사해서 값을 채운다 (.env 는 커밋 금지)
DB_ROOT_PASSWORD=
DB_USERNAME=dotorich
DB_PASSWORD=
# 32바이트(영문 32자) 이상 무작위 문자열. 예: openssl rand -base64 48
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
GEMINI_API_KEY=
# 프론트 주소. 같은 주소(Nginx)로 서비스하면 그 주소와 로컬 개발 주소
CORS_ALLOWED_ORIGINS=http://localhost:5173
